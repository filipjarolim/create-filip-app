# Copy this file to .env and replace every placeholder.
# Metro inlines EXPO_PUBLIC_ variables when the dev server starts. Restart it after edits.
# For EAS builds, set the same keys in the Expo project's environment (development, preview, production).
# Do not put the Supabase service-role key in this file. It belongs only on the server.

# Supabase project URL, from Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://bvpooknglnblxgwwylvk.supabase.co

# Supabase anon (publishable) key. This key is safe to ship inside the app; row level security protects data.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat public SDK keys. Use the Apple key on iOS and the Google key on Android.
# Test Store keys look like test_... and work in development builds.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_REPLACE_ME
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_REPLACE_ME

# Entitlement identifier configured in the RevenueCat dashboard. The paywall treats this entitlement as "subscribed".
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro

# URL scheme used for auth redirects and deep links. Must match the scheme in app.config.ts.
EXPO_PUBLIC_APP_SCHEME=createfilipapp

# Minimum standalone version. Older store builds show an update notice. Use 1.0.0 until you need a force update.
EXPO_PUBLIC_MIN_APP_VERSION=1.0.0

# Paywall order. annual-first leads with the annual package. control leads with the weekly package.
EXPO_PUBLIC_PAYWALL_VARIANT=annual-first

# Optional comma-separated SHA-256 pins for the Supabase host. Leave empty in development.
# EXPO_PUBLIC_TLS_PINS=

# Optional Expo Updates URL from `eas update:configure`. Leave empty until EAS gives you one.
# EXPO_PUBLIC_UPDATES_URL=

# Local UI preview. Signs in as preview@example.com and skips store setup.
# Never set this in the production EAS environment.
# EXPO_PUBLIC_UI_PREVIEW=1
