    "@types/react": "~19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "lightningcss": "1.30.1",
    "postcss": "8.5.6",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix --no-warn-ignored"
  }
}
