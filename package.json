{
  "name": "create-filip-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "exports": {
    "./ui": "./components/ui/index.ts",
    "./premade": "./components/premade/index.ts"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci",
    "rename": "node scripts/rebrand.js",
    "rebrand": "node scripts/rebrand.js",
    "swarm": "node scripts/swarm.mjs",
    "swarm:status": "node scripts/swarm.mjs status",
    "swarm:link": "node scripts/swarm.mjs link",
    "pages": "node scripts/publish-pages.mjs",
    "pages:deploy": "node scripts/publish-pages.mjs --deploy",
    "swarm:init": "node scripts/swarm.mjs init",
    "feature:list": "node scripts/swarm.mjs list-features",
    "feature:prune": "node scripts/swarm.mjs prune",
    "assets": "node scripts/generate-assets.js",
    "secrets": "node scripts/scan-secrets.js",
    "metadata": "node scripts/check-metadata.js",
    "analyze": "node scripts/analyze-bundle.js",
    "prepare": "husky",
    "eas-build-post-install": "node scripts/check-env.js",
    "config": "expo config --type public",
    "build:development": "eas build --profile development --platform all",
    "build:preview": "eas build --profile preview --platform all",
    "build:production": "eas build --profile production --platform all",
    "submit:preview": "eas submit --profile preview --platform all --latest",
    "submit:production": "eas submit --profile production --platform all --latest"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.3.2",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/query-async-storage-persister": "5.105.1",
    "@tanstack/react-query": "5.105.1",
    "@tanstack/react-query-persist-client": "5.105.1",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "expo": "~58.0.22",
    "expo-application": "~58.1.2",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.5",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-store-review": "~58.0.2",
    "expo-system-ui": "~58.0.7",
    "expo-tracking-transparency": "~58.0.2",
    "expo-updates": "~58.0.20",
    "expo-web-browser": "~58.0.7",
    "husky": "^9.1.7",
    "i18next": "^26.7.1",
    "lint-staged": "^16.4.0",
    "lucide-react-native": "1.66.0",
    "nativewind": "5.0.0-rc.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.11",
    "react-native": "0.88.1",
    "react-native-css": "3.1.0-rc.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-purchases": "11.0.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
